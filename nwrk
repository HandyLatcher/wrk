        LDRH R0, [R2]       ; R0 = first number

        LDR R2, =NUM2
        LDRH R1, [R2]       ; R1 = second number

        ADD R0, R0, R1      ; Add them

        LDR R2, =RESULT
        STR R0, [R2]        ; Save the answer

